{
  "name": "callva-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.mjs",
    "tunnel": "bash scripts/voice-tunnel.sh",
    "dev:voice": "concurrently -n web,api,tunnel -c cyan,green,magenta \"vite\" \"node --watch server/index.mjs\" \"bash scripts/voice-tunnel.sh\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
