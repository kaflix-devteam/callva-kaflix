# Copy to .env (gitignored). Leave VOICE_* empty to run the demo in simulation mode only.

# SSH target that hosts the loopback-only model servers (used by scripts/voice-tunnel.sh)
VOICE_HOST=user@gpu-server

# Where the Express API reaches the models (through the tunnel by default)
VOICE_LLM_URL=http://127.0.0.1:11435
VOICE_LLM_MODEL=qwen3.5:4b
VOICE_TTS_URL=http://127.0.0.1:18601
VOICE_ASR_URL=http://127.0.0.1:18602

# Optional
# PORT=3001
